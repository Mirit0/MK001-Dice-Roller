    private static int DieIndex(int s) { switch(s){case 4:return 0;case 6:return 1;case 8:return 2;case 10:return 3;case 12:return 4;case 20:return 5;default:return 6;} }

    private string Reply(Roll roll)
    {
        if (roll.Sides == 0)
        {
            bool h = roll.Values[0] == 0;
            return (h ? "Heads" : "Tails") + (roll.Purpose.Length > 0 ? " for " + roll.Purpose : "") + ". " + Choose(h ? HeadsReplies : TailsReplies);
        }
        int total = 0; for (int i = 0; i < roll.Count; i++) total += roll.Values[i];
        string beg;
        if (roll.Count == 1)
        {
            string num = roll.Values[0].ToString();
            switch (Uniform(4)) { case 0: beg = num + " on the D" + roll.Sides; break; case 1: beg = "D" + roll.Sides + " landed on " + num; break; case 2: beg = "D" + roll.Sides + ": " + num; break; default: beg = "Got " + num + " on the D" + roll.Sides; break; }
            if (roll.Purpose.Length > 0) beg += " for " + roll.Purpose;
            beg += ".";
        }
        else
        {
            beg = roll.Count + "d" + roll.Sides + ": ";
            for (int i = 0; i < roll.Count; i++) beg += (i == 0 ? "" : i == roll.Count - 1 ? " and " : ", ") + roll.Values[i];
            beg += ". Total: " + total + (roll.Purpose.Length > 0 ? " for " + roll.Purpose : "") + ".";
        }
        int min = roll.Count, max = roll.Count * roll.Sides, diff = max - min;
        int tier = total == min ? 0 : total == max ? 4 : (total - min) * 100 <= diff * 30 ? 1 : (total - min) * 100 >= diff * 75 ? 3 : 2;
        string p = roll.Purpose.ToLowerInvariant();
        int pt = p.Contains("initiative") ? 0 : p.Contains("damage") ? 1 : (p.Contains("luck") || p.Contains("lucky")) ? 2 : -1;
        int style = Uniform(10);
        string[] choices = pt >= 0 && style < 4 ? PurposeReplies[pt][tier] : style >= 8 ? DieReplies[DieIndex(roll.Sides)] : Replies[tier];
        return beg + " " + Choose(choices);
    }

    private string Choose(string[] c)
    {
        int first = Uniform(c.Length), chosen = first;
        for (int i = 0; i < c.Length; i++) { int ix = (first + i) % c.Length; if (!recentReplies.Contains(c[ix])) { chosen = ix; break; } }
        string prev = ""; foreach (string s in recentReplies) prev = s;
        if (c.Length > 1 && c[chosen] == prev) for (int i = 1; i < c.Length; i++) if (c[(chosen + i) % c.Length] != prev) { chosen = (chosen + i) % c.Length; break; }
        string r = c[chosen]; recentReplies.Enqueue(r); while (recentReplies.Count > 12) recentReplies.Dequeue(); return r;
    }

    private struct V3
    {
        internal double X, Y, Z;
        internal V3(double x, double y, double z) { X = x; Y = y; Z = z; }
        public static V3 operator +(V3 a, V3 b) { return new V3(a.X+b.X,a.Y+b.Y,a.Z+b.Z); }
        public static V3 operator -(V3 a, V3 b) { return new V3(a.X-b.X,a.Y-b.Y,a.Z-b.Z); }
        public static V3 operator *(V3 a, double f) { return new V3(a.X*f,a.Y*f,a.Z*f); }
        internal static double Dot(V3 a, V3 b) { return a.X*b.X+a.Y*b.Y+a.Z*b.Z; }
        internal static V3 Cross(V3 a, V3 b) { return new V3(a.Y*b.Z-a.Z*b.Y,a.Z*b.X-a.X*b.Z,a.X*b.Y-a.Y*b.X); }
        internal V3 Unit() { double d=Math.Sqrt(X*X+Y*Y+Z*Z); return d>0?this*(1.0/d):this; }
    }

    private struct Q
    {
        internal double W, X, Y, Z;
        internal Q(double w, double x, double y, double z) { W=w;X=x;Y=y;Z=z; }
        internal static Q Identity { get { return new Q(1,0,0,0); } }
        public static Q operator *(Q a, Q b) { return new Q(a.W*b.W-a.X*b.X-a.Y*b.Y-a.Z*b.Z,a.W*b.X+a.X*b.W+a.Y*b.Z-a.Z*b.Y,a.W*b.Y-a.X*b.Z+a.Y*b.W+a.Z*b.X,a.W*b.Z+a.X*b.Y-a.Y*b.X+a.Z*b.W); }
        internal Q Unit() { double d=Math.Sqrt(W*W+X*X+Y*Y+Z*Z); return d>0?new Q(W/d,X/d,Y/d,Z/d):Identity; }
        internal static Q AxisAngle(V3 axis, double a) { axis=axis.Unit(); double s=Math.Sin(a/2); return new Q(Math.Cos(a/2),axis.X*s,axis.Y*s,axis.Z*s); }
        internal static Q Euler(double x, double y, double z) { return AxisAngle(new V3(0,0,1),z)*AxisAngle(new V3(0,1,0),y)*AxisAngle(new V3(1,0,0),x); }
        internal V3 Apply(V3 p) { V3 v=new V3(X,Y,Z),t=V3.Cross(v,p)*2; return p+t*W+V3.Cross(v,t); }
        internal static Q Between(V3 from, V3 to)
        {
            V3 a=from.Unit(),b=to.Unit(); double d=V3.Dot(a,b);
            if(d>0.999999999)return Identity;
            if(d<-0.999999999){V3 seed=Math.Abs(a.X)<0.8?new V3(1,0,0):new V3(0,1,0);return AxisAngle(V3.Cross(a,seed),Math.PI);}
            V3 c=V3.Cross(a,b);return new Q(1+d,c.X,c.Y,c.Z).Unit();
        }
        internal static Q Slerp(Q a, Q b, double t)
        {
            double dot=a.W*b.W+a.X*b.X+a.Y*b.Y+a.Z*b.Z;
            if(dot<0){b=new Q(-b.W,-b.X,-b.Y,-b.Z);dot=-dot;}
            double ka=1-t,kb=t;
            if(dot<0.9995){dot=Math.Max(-1,Math.Min(1,dot));double th=Math.Acos(dot),de=Math.Sin(th);ka=Math.Sin((1-t)*th)/de;kb=Math.Sin(t*th)/de;}
            return new Q(ka*a.W+kb*b.W,ka*a.X+kb*b.X,ka*a.Y+kb*b.Y,ka*a.Z+kb*b.Z).Unit();
        }
    }

    private const double SettleStart = 1.13, SettleEnd = 1.86;
    private static double Angle(double t, double phase, double velocity)
    {
        double f=Math.Max(0,Math.Min(1,t/SettleEnd));
        return phase+velocity*SettleEnd*(1-Math.Pow(1-f,3))/3+Math.Sin(t*27)*0.07*Math.Pow(1-f,2);
    }
    private static Q TumbleRotation(double t, int slot) { return Q.Euler(Angle(t,0.35+slot*.41,13.6+slot*.7),Angle(t,0.55+slot*.33,18.3+slot*.4),Angle(t,0.12+slot*.18,11.4+slot*.5)); }

    private sealed class Mesh { internal V3[] Vertices; internal int[][] Faces; }

    private static Mesh Make(V3[] verts, int[][] faces)
    {
        double max=0;
        for(int i=0;i<verts.Length;i++){double l=Math.Sqrt(V3.Dot(verts[i],verts[i]));if(l>max)max=l;}
        for(int i=0;i<verts.Length;i++)verts[i]=verts[i]*(1.0/max);
        for(int i=0;i<faces.Length;i++)
        {
            int[]f=faces[i];V3 a=verts[f[0]],b=verts[f[1]],c=verts[f[2]],ctr=new V3(0,0,0);
            foreach(int k in f)ctr+=verts[k];
            if(V3.Dot(V3.Cross(b-a,c-a),ctr)<0)Array.Reverse(f);
        }
        return new Mesh{Vertices=verts,Faces=faces};
    }

    private static Mesh Tetra(){return Make(new V3[]{new V3(1,1,1),new V3(-1,-1,1),new V3(-1,1,-1),new V3(1,-1,-1)},new int[][]{new int[]{0,1,2},new int[]{0,3,1},new int[]{0,2,3},new int[]{1,3,2}});}
    private static Mesh Cube(){return Make(new V3[]{new V3(-1,-1,-1),new V3(1,-1,-1),new V3(1,1,-1),new V3(-1,1,-1),new V3(-1,-1,1),new V3(1,-1,1),new V3(1,1,1),new V3(-1,1,1)},new int[][]{new int[]{0,1,2,3},new int[]{4,7,6,5},new int[]{0,4,5,1},new int[]{1,5,6,2},new int[]{2,6,7,3},new int[]{3,7,4,0}});}
    private static Mesh Octa(){V3[]a=new V3[]{new V3(1,0,0),new V3(-1,0,0),new V3(0,1,0),new V3(0,-1,0),new V3(0,0,1),new V3(0,0,-1)};return Make(a,new int[][]{new int[]{4,0,2},new int[]{4,2,1},new int[]{4,1,3},new int[]{4,3,0},new int[]{5,2,0},new int[]{5,1,2},new int[]{5,3,1},new int[]{5,0,3}});}
    private static Mesh Ten()
    {
        V3[]v=new V3[12];double apex=1.6,rZ=apex*(1-Math.Cos(Math.PI/5))/(1+Math.Cos(Math.PI/5));
        v[0]=new V3(0,0,apex);v[1]=new V3(0,0,-apex);
        for(int i=0;i<5;i++){double a=i*Math.PI*2/5;v[2+i]=new V3(Math.Cos(a),Math.Sin(a),rZ);v[7+i]=new V3(Math.Cos(a+Math.PI/5),Math.Sin(a+Math.PI/5),-rZ);}
        int[][]f=new int[10][];for(int i=0;i<5;i++){f[i]=new int[]{0,2+i,7+i,2+(i+1)%5};f[5+i]=new int[]{1,7+i,2+(i+1)%5,7+(i+1)%5};}
        return Make(v,f);
    }
    private static Mesh Icosa()
    {
        double p=(1+Math.Sqrt(5))/2;
        V3[]v=new V3[]{new V3(0,1,p),new V3(0,-1,p),new V3(0,1,-p),new V3(0,-1,-p),new V3(1,p,0),new V3(-1,p,0),new V3(1,-p,0),new V3(-1,-p,0),new V3(p,0,1),new V3(-p,0,1),new V3(p,0,-1),new V3(-p,0,-1)};
        double smallest=double.MaxValue;
        for(int i=0;i<v.Length;i++)for(int j=i+1;j<v.Length;j++){double d=V3.Dot(v[i]-v[j],v[i]-v[j]);if(d<smallest)smallest=d;}
        List<int[]> faces=new List<int[]>();
        for(int i=0;i<v.Length;i++)for(int j=i+1;j<v.Length;j++)for(int k=j+1;k<v.Length;k++)
        {double a=V3.Dot(v[i]-v[j],v[i]-v[j]),b=V3.Dot(v[i]-v[k],v[i]-v[k]),c=V3.Dot(v[j]-v[k],v[j]-v[k]);if(Math.Abs(a-smallest)<0.0001&&Math.Abs(b-smallest)<0.0001&&Math.Abs(c-smallest)<0.0001)faces.Add(new int[]{i,j,k});}
        return Make(v,faces.ToArray());
    }
    private static Mesh Dodeca(Mesh ico)
    {
        V3[]vert=new V3[ico.Faces.Length];
        for(int i=0;i<ico.Faces.Length;i++){int[]t=ico.Faces[i];vert[i]=(ico.Vertices[t[0]]+ico.Vertices[t[1]]+ico.Vertices[t[2]])*(1.0/3);}
        int[][]faces=new int[ico.Vertices.Length][];
        for(int i=0;i<ico.Vertices.Length;i++)
        {
            List<int> touching=new List<int>();
            for(int j=0;j<ico.Faces.Length;j++)foreach(int k in ico.Faces[j])if(k==i){touching.Add(j);break;}
            V3 n=ico.Vertices[i].Unit(),axis=Math.Abs(n.Z)<0.8?new V3(0,0,1):new V3(0,1,0);
            V3 right=V3.Cross(axis,n).Unit(),up=V3.Cross(n,right);
            for(int a=0;a<touching.Count;a++)for(int b=a+1;b<touching.Count;b++)
            {V3 u=vert[touching[a]],vv=vert[touching[b]];if(Math.Atan2(V3.Dot(u,up),V3.Dot(u,right))>Math.Atan2(V3.Dot(vv,up),V3.Dot(vv,right))){int tmp=touching[a];touching[a]=touching[b];touching[b]=tmp;}}
            faces[i]=touching.ToArray();
        }
        return Make(vert,faces);
    }
    private static readonly Mesh IcoMesh = Icosa();
    private static readonly Mesh[] Models = new Mesh[]{Tetra(),Cube(),Octa(),Ten(),Dodeca(IcoMesh),IcoMesh};
    private static Mesh ModelFor(int s){switch(s){case 4:return Models[0];case 6:return Models[1];case 8:return Models[2];case 10:return Models[3];case 12:return Models[4];default:return Models[5];}}

    private sealed class RenderFace{internal PointF[]Points;internal bool Visible;internal double Depth,Brightness;internal float X,Y,Area;internal int Id;}
    private sealed class DieView
    {
        internal Mesh Geometry;
        internal V3[] Rotated;
        internal RenderFace[] Faces;
        internal int[] Order;
        internal int TargetFace;
        internal Q LandingStart, LandingEnd;
        internal DieView(Mesh mesh, int chosenFace, int slot)
        {
            Geometry=mesh;TargetFace=chosenFace;
            Rotated=new V3[mesh.Vertices.Length];
            Faces=new RenderFace[mesh.Faces.Length];Order=new int[mesh.Faces.Length];
            for(int i=0;i<Faces.Length;i++){Faces[i]=new RenderFace{Points=new PointF[mesh.Faces[i].Length],Id=i};Order[i]=i;}
            int[]f=mesh.Faces[chosenFace];
            V3 a=mesh.Vertices[f[0]],b=mesh.Vertices[f[1]],c=mesh.Vertices[f[2]];
            V3 n=V3.Cross(b-a,c-a).Unit();
            LandingStart=TumbleRotation(SettleStart,slot);
            Q align=Q.Between(LandingStart.Apply(n),new V3(0,0,1));
            Q front=align*LandingStart;
            V3 edge=front.Apply(b-a);
            LandingEnd=(Q.AxisAngle(new V3(0,0,1),-Math.Atan2(edge.Y,edge.X))*front).Unit();
        }
    }

    private static readonly Color CpBg     = Color.FromArgb(255,  8,  2, 14);
    private static readonly Color CpRed    = Color.FromArgb(255,220, 30, 55);
    private static readonly Color CpCyan   = Color.FromArgb(255,  0,230,255);

    private sealed class RollWindow : Form
    {
        private const double RevealAt = SettleEnd, EndAt = 2.88;
        private readonly Roll roll;
        private readonly Func<bool> wasStopped;
        private readonly Stopwatch clock = new Stopwatch();
        private readonly System.Windows.Forms.Timer tick = new System.Windows.Forms.Timer();
        private readonly DieView[] dice;
        private readonly Font fntHeader  = new Font("Courier New", 11, FontStyle.Bold);
        private readonly Font fntFace    = new Font("Courier New", 13, FontStyle.Bold);
        private readonly Font fntFaceSm  = new Font("Courier New", 10, FontStyle.Bold);
        private readonly Font fntNumber  = new Font("Courier New", 22, FontStyle.Bold);
        private readonly Font fntLabel   = new Font("Courier New",  9, FontStyle.Regular);
        private readonly Pen penEdge     = new Pen(Color.FromArgb(220, 220, 30, 55), 1.6f);
        private readonly Pen penHalo     = new Pen(Color.FromArgb( 50, 220, 30, 55), 6f);
        private readonly Pen penSep      = new Pen(Color.FromArgb( 90, 180, 20, 40), 1f);
        private readonly Pen penEdgeCyan = new Pen(Color.FromArgb(200,   0,230,255), 1.4f);
        private readonly Pen penHaloCyan = new Pen(Color.FromArgb( 45,   0,200,255), 5f);
        private readonly SolidBrush[] bFaceRed  = new SolidBrush[9];
        private readonly SolidBrush[] bFaceCyan = new SolidBrush[9];
        private readonly SolidBrush bWhite   = new SolidBrush(Color.FromArgb(255,255,255,255));
        private readonly SolidBrush bSecond  = new SolidBrush(Color.FromArgb(200,220, 30, 55));
        private readonly SolidBrush bSecCyan = new SolidBrush(Color.FromArgb(180,  0,230,255));
        private readonly SolidBrush bDark    = new SolidBrush(Color.FromArgb(220,  8,  2, 14));
        private bool cheap;
        internal bool Completed { get; private set; }

        internal RollWindow(Roll req, Func<bool> cancel)
        {
            roll=req;wasStopped=cancel;
            int n=req.Sides==100?req.Count*2:req.Count;
            dice=new DieView[req.Sides==0?0:n];
            for(int i=0;i<dice.Length;i++)
            {
                int which=req.Sides==100?i/2:i;
                int face=req.Sides==100?(i%2==0?req.Tens[which]:req.Units[which]):req.Values[which]-1;
                dice[i]=new DieView(ModelFor(req.Sides==100?10:req.Sides),face,i);
            }
            for(int i=0;i<9;i++){bFaceRed[i]=new SolidBrush(Color.FromArgb(255,60+i*18,5+i*4,10+i*5));bFaceCyan[i]=new SolidBrush(Color.FromArgb(255,0+i*5,40+i*20,50+i*22));}
            int cols=n>4?(n+1)/2:n;
            int w=req.Sides==0?320:Math.Max(320,Math.Min(740,cols*164+80));
            ClientSize=new Size(w,n>4?440:266);
            StartPosition=FormStartPosition.CenterScreen;
            FormBorderStyle=FormBorderStyle.None;
            ShowInTaskbar=false;
            TopMost=false;
            BackColor=CpBg;
            Opacity=0.97;
            SetStyle(ControlStyles.AllPaintingInWmPaint|ControlStyles.UserPaint|ControlStyles.OptimizedDoubleBuffer,true);
            tick.Interval=16;
            tick.Tick+=OnTick;
            Shown+=delegate{if(wasStopped()){CancelRoll();return;}clock.Start();tick.Start();Invalidate();};
        }

        protected override bool ShowWithoutActivation { get { return true; } }

        private void OnTick(object s, EventArgs e)
        {
            if(wasStopped()){CancelRoll();return;}
            if(clock.Elapsed.TotalSeconds>=EndAt){tick.Stop();Completed=true;Close();return;}
            Invalidate();
        }

        internal void CancelRoll(){Completed=false;tick.Stop();if(!IsDisposed)Close();}

        protected override void Dispose(bool d)
        {
            if(d)
            {
                tick.Stop();tick.Dispose();
                fntHeader.Dispose();fntFace.Dispose();fntFaceSm.Dispose();fntNumber.Dispose();fntLabel.Dispose();
                penEdge.Dispose();penHalo.Dispose();penSep.Dispose();penEdgeCyan.Dispose();penHaloCyan.Dispose();
                bWhite.Dispose();bSecond.Dispose();bSecCyan.Dispose();bDark.Dispose();
                for(int i=0;i<9;i++){bFaceRed[i].Dispose();bFaceCyan[i].Dispose();}
            }
            base.Dispose(d);
        }

        protected override void OnPaint(PaintEventArgs e)
        {
            base.OnPaint(e);
            Stopwatch sw=Stopwatch.StartNew();
            Graphics g=e.Graphics;
            g.Clear(CpBg);
            g.SmoothingMode=cheap?SmoothingMode.HighSpeed:SmoothingMode.AntiAlias;
            g.TextRenderingHint=TextRenderingHint.AntiAliasGridFit;
            double time=Math.Min(EndAt,clock.Elapsed.TotalSeconds);
            bool finished=time>=RevealAt;
            if(!cheap){using(Pen scanPen=new Pen(Color.FromArgb(18,255,0,30),1))for(int y=0;y<Height;y+=3)g.DrawLine(scanPen,0,y,Width,y);}
            DrawCornerBrackets(g);
            string dieLabel=roll.Sides==0?"COIN FLIP":(roll.Count>1?roll.Count+"xD"+roll.Sides:"D"+roll.Sides);
            g.DrawString("[ "+dieLabel+" "+(finished?"// LOCKED":"// ROLLING")+" ]",fntHeader,finished?bSecCyan:bSecond,14,10);
            g.DrawLine(penSep,14,36,Width-14,36);
            if(roll.Sides==0)DrawCoin(g,time,finished);
            else
            {
                int n=dice.Length,cols=n>4?(n+1)/2:n;
                double cell=(Width-38.0)/cols;float sz=(float)Math.Min(80,cell*0.39);
                for(int i=0;i<n;i++)
                {
                    int row=i/cols,col=i%cols,rowCount=Math.Min(cols,n-row*cols);
                    bool tens=roll.Sides==100&&i%2==0;
                    double x=19+(cols-rowCount)*cell*0.5+cell*(col+0.5),y=125+row*165;
                    DrawDie(g,dice[i],x,y,sz,time,i,finished,roll.Sides==100,tens);
                }
            }
            if(finished)
            {
                string res=ResultLabel();SizeF ms=g.MeasureString(res,fntNumber);
                float rx=(Width-ms.Width)/2f-14,ry=Height-56;
                if(!cheap)for(int gw=8;gw>0;gw-=2)using(SolidBrush gb=new SolidBrush(Color.FromArgb(20,CpCyan)))g.FillRectangle(gb,rx-gw,ry-gw/2,ms.Width+28+gw*2,42+gw);
                g.FillRectangle(bDark,rx,ry,ms.Width+28,42);
                g.DrawRectangle(penEdgeCyan,rx,ry,ms.Width+28,42);
                g.DrawString(res,fntNumber,bWhite,rx+14,ry+6);
            }
            else if((int)(time*4)%2==0)g.DrawString("\u25B6 TUMBLING...",fntLabel,bSecond,14,Height-30);
            sw.Stop();if(sw.ElapsedMilliseconds>35)cheap=true;
        }

        private void DrawCornerBrackets(Graphics g)
        {
            const int L=14;
            using(Pen p=new Pen(Color.FromArgb(140,CpRed),1.5f))
            {
                g.DrawLine(p,4,4+L,4,4);g.DrawLine(p,4,4,4+L,4);
                g.DrawLine(p,Width-4-L,4,Width-4,4);g.DrawLine(p,Width-4,4,Width-4,4+L);
                g.DrawLine(p,4,Height-4-L,4,Height-4);g.DrawLine(p,4,Height-4,4+L,Height-4);
                g.DrawLine(p,Width-4-L,Height-4,Width-4,Height-4);g.DrawLine(p,Width-4,Height-4,Width-4,Height-4-L);
            }
        }

        private string ResultLabel()
        {
            if(roll.Sides==0)return roll.Values[0]==0?"HEADS":"TAILS";
            if(roll.Count==1)return roll.Values[0].ToString();
            int s=0;for(int i=0;i<roll.Count;i++)s+=roll.Values[i];return "TOTAL "+s;
        }

        private void DrawDie(Graphics g,DieView view,double cx,double cy,float radius,double t,int slot,bool finished,bool percentile,bool tens)
        {
            Mesh mesh=view.Geometry;double at=Math.Min(SettleEnd,t);Q ori;
            if(at<SettleStart)ori=TumbleRotation(at,slot);
            else{double u=Math.Max(0,Math.Min(1,(at-SettleStart)/(SettleEnd-SettleStart)));ori=Q.Slerp(view.LandingStart,view.LandingEnd,1-Math.Pow(1-u,3));}
            double left=Math.Max(0,1-at/SettleEnd);cy+=Math.Abs(Math.Sin(at*11))*11*left*left;
            for(int i=0;i<mesh.Vertices.Length;i++)view.Rotated[i]=ori.Apply(mesh.Vertices[i]);
            int vis=0;
            for(int i=0;i<mesh.Faces.Length;i++)
            {
                int[]face=mesh.Faces[i];RenderFace r=view.Faces[i];
                V3 a=view.Rotated[face[0]],b=view.Rotated[face[1]],c=view.Rotated[face[2]];
                V3 norm=V3.Cross(b-a,c-a).Unit();r.Visible=norm.Z>0.012;if(!r.Visible)continue;
                r.Brightness=Math.Max(0,Math.Min(.999,0.40+norm.Z*.41+norm.X*.12));
                double zz=0,fx=0,fy=0;
                for(int k=0;k<face.Length;k++){V3 pt=view.Rotated[face[k]];double sc=3.8/(3.8-pt.Z*.5);float px=(float)(cx+radius*pt.X*sc),py=(float)(cy-radius*pt.Y*sc);r.Points[k]=new PointF(px,py);fx+=px;fy+=py;zz+=pt.Z;}
                r.X=(float)(fx/face.Length);r.Y=(float)(fy/face.Length);r.Depth=zz/face.Length;
                float area=0;for(int k=0;k<face.Length;k++){PointF pp=r.Points[k],q=r.Points[(k+1)%face.Length];area+=pp.X*q.Y-q.X*pp.Y;}r.Area=Math.Abs(area)*0.5f;
                view.Order[vis++]=i;
            }
            for(int i=1;i<vis;i++){int tmp=view.Order[i],j=i-1;while(j>=0&&view.Faces[view.Order[j]].Depth>view.Faces[tmp].Depth){view.Order[j+1]=view.Order[j];j--;}view.Order[j+1]=tmp;}
            bool isRed=percentile&&tens;
            SolidBrush[]palette=isRed?bFaceRed:bFaceCyan;Pen ePen=isRed?penEdge:penEdgeCyan,hPen=isRed?penHalo:penHaloCyan;
            for(int i=0;i<vis;i++)
            {
                RenderFace r=view.Faces[view.Order[i]];int shade=(int)(r.Brightness*9);if(shade>8)shade=8;
                g.FillPolygon(palette[shade],r.Points);if(!cheap)g.DrawPolygon(hPen,r.Points);g.DrawPolygon(ePen,r.Points);
                bool chosen=finished&&r.Id==view.TargetFace;
                if(r.Area>210||chosen)
                {
                    string txt=percentile?(tens?(r.Id*10).ToString("00"):r.Id.ToString()):(r.Id+1).ToString();
                    Font fnt=chosen&&radius>58?fntNumber:(chosen||r.Area>=650?fntFace:fntFaceSm);
                    SizeF sz=g.MeasureString(txt,fnt);
                    int[]face=mesh.Faces[r.Id];V3 p1=view.Rotated[face[0]],p2=view.Rotated[face[1]];
                    double s1=3.8/(3.8-p1.Z*.5),s2=3.8/(3.8-p2.Z*.5);
                    float ang=(float)(Math.Atan2(-(p2.Y*s2-p1.Y*s1),p2.X*s2-p1.X*s1)*180/Math.PI);
                    float nom=(float)Math.Sqrt(r.Area),scale=Math.Min(1f,nom*0.58f/Math.Max(1,Math.Max(sz.Width,sz.Height)));
                    GraphicsState st=g.Save();g.TranslateTransform(r.X,r.Y);g.RotateTransform(ang);g.ScaleTransform(scale,scale);
                    if(!cheap&&chosen){Color glowCol=isRed?CpRed:CpCyan;for(int gw=4;gw>0;gw--)using(SolidBrush gb=new SolidBrush(Color.FromArgb(35+gw*8,glowCol)))g.DrawString(txt,fnt,gb,-sz.Width/2+gw*.4f,-sz.Height/2+gw*.4f);}
                    g.DrawString(txt,fnt,chosen?bWhite:(isRed?bSecond:bSecCyan),-sz.Width/2,-sz.Height/2);
                    g.Restore(st);
                }
            }
        }

        private static double CoinAngle(double t,bool heads){double u=Math.Max(0,Math.Min(1,t/SettleEnd)),travel=1-Math.Pow(1-u,3);return(heads?24.0:25.0)*Math.PI*travel;}
        private void DrawCoin(Graphics g,double t,bool finished)
        {
            float cx=Width/2f,cy=124,radius=79;double el=Math.Min(SettleEnd,t),angle=CoinAngle(el,roll.Values[0]==0);
            float half=(float)(Math.Abs(Math.Cos(angle))*radius);if(half<4)half=4;
            double left=Math.Max(0,1-el/SettleEnd);float bounce=(float)(Math.Abs(Math.Sin(el*11))*17*left*left);
            bool heads=Math.Cos(angle)>=0;
            SolidBrush[]palette=heads?bFaceCyan:bFaceRed;Pen ep=heads?penEdgeCyan:penEdge,hp=heads?penHaloCyan:penHalo;
            RectangleF rect=new RectangleF(cx-half,cy-radius+bounce,half*2,radius*2);
            g.FillEllipse(palette[8],rect);if(!cheap)g.DrawEllipse(hp,rect);g.DrawEllipse(ep,rect);
            if(half>36||finished)
            {
                string lbl=heads?"H":"T";SizeF sz=g.MeasureString(lbl,fntNumber);
                if(!cheap)for(int gw=4;gw>0;gw--)using(SolidBrush gb=new SolidBrush(Color.FromArgb(40+gw*10,heads?CpCyan:CpRed)))g.DrawString(lbl,fntNumber,gb,cx-sz.Width/2+gw*.5f,cy+bounce-sz.Height/2+gw*.5f);
                g.DrawString(lbl,fntNumber,bWhite,cx-sz.Width/2,cy+bounce-sz.Height/2);
            }
        }
    }
}
